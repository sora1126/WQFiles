diff --git a/Sources/JITSession.swift b/Sources/JITSession.swift
index 1b20dcb..116ee29 100644
--- a/Sources/JITSession.swift
+++ b/Sources/JITSession.swift
@@ -29,6 +29,60 @@ final class JITSession {
         self.configuration = configuration
     }
 
+    func installedApplications() throws -> [StikJIT.InstalledApplication] {
+        let tunnel = try makeTunnel()
+        defer { tunnel.free() }
+        var service: OpaquePointer?
+        try IdeviceFFI.check("failed to connect app service") {
+            app_service_connect_rsd(tunnel.adapter, tunnel.handshake, &service)
+        }
+        guard let service else { throw StikJITError.device(code: -1, subCode: 0, message: "App service unavailable") }
+        defer { app_service_free(service) }
+
+        var apps: UnsafeMutablePointer<AppListEntryC>?
+        var appCount: UInt = 0
+        try IdeviceFFI.check("failed to list installed apps") {
+            app_service_list_apps(service, 1, 1, 0, 0, 1, &apps, &appCount)
+        }
+        defer { if let apps { app_service_free_app_list(apps, appCount) } }
+
+        var processes: UnsafeMutablePointer<ProcessTokenC>?
+        var processCount: UInt = 0
+        try IdeviceFFI.check("failed to list running processes") {
+            app_service_list_processes(service, &processes, &processCount)
+        }
+        defer { if let processes { app_service_free_process_list(processes, processCount) } }
+
+        func filePath(_ raw: String) -> String {
+            guard let url = URL(string: raw), url.isFileURL else { return raw }
+            return url.path
+        }
+        var running: [(String, Int32)] = []
+        if let processes {
+            for index in 0..<Int(processCount) {
+                let process = processes[index]
+                guard let raw = process.executable_url.flatMap({ String(validatingUTF8: $0) }),
+                      process.pid > 1, process.pid <= UInt32(Int32.max) else { continue }
+                running.append((filePath(raw), Int32(process.pid)))
+            }
+        }
+        var result: [StikJIT.InstalledApplication] = []
+        if let apps {
+            for index in 0..<Int(appCount) {
+                let app = apps[index]
+                guard let bundleID = app.bundle_identifier.flatMap({ String(validatingUTF8: $0) }),
+                      !bundleID.isEmpty else { continue }
+                let name = app.name.flatMap({ String(validatingUTF8: $0) }) ?? bundleID
+                let path = app.path.flatMap({ String(validatingUTF8: $0) }).map(filePath)
+                let pid = path.flatMap { bundlePath in
+                    running.first { $0.0.hasPrefix(bundlePath + "/") }?.1
+                }
+                result.append(.init(name: name, bundleIdentifier: bundleID, pid: pid))
+            }
+        }
+        return result.sorted { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
+    }
+
     func enableJIT(targetPID: Int32,
                    script: StikJIT.Script,
                    forceScript: Bool,
